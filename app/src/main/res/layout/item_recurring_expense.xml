<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Expense Name -->
        <TextView
            android:id="@+id/tvRecurringExpenseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recurring Expense Name"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Amount and Frequency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecurringExpenseAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="$50.00"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRecurringExpenseFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Start Date -->
        <TextView
            android:id="@+id/tvRecurringExpenseStartDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starts: 2023-11-25"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>